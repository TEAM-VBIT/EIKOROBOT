{
  "name": "EIKOROBOT",
  "description": "Telegram Management Bot",
  "repository": "https://github.com/TEAM-VBIT/EIKOROBOT",
  "keywords": ["telegram", "management", "pyrogram"],
  "env": {
    "TOKEN": {
      "description": "Bot Token from BotFather",
      "required": true
    },
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API HASH",
      "required": true
    },
    "DB_URL": {
      "description": "MongoDB URL",
      "required": true
    },
    "ALONE_OWNER_ID": {
      "description": "Owner Telegram ID",
      "required": true
    },
    "OWNER_ID": {
      "description": "Owner Telegram ID",
      "required": true
    },
    "LOG_GROUP_ID": {
      "description": "Log Group ID",
      "required": false
    },
    "USER_STRING": {
      "description": "Pyrogram Session String",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
